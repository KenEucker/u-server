# ---------------------------------------------------------------------------
# u-server host configuration
# ---------------------------------------------------------------------------
# Copy to ./server.env at the repository root, edit, then run: sudo ./install.sh
#
#   cp config/server.env.example server.env
#   nano server.env
#   sudo ./install.sh
#
# This file is read by every installer stage. It is NOT tracked by git
# (server.env is in .gitignore). Do not put secrets here: the installer
# generates them into /etc/u-server/secrets.env with 0600 permissions.
# ---------------------------------------------------------------------------

# --- Host identity ---------------------------------------------------------

# Hostname to set on this machine, via hostnamectl. /etc/hosts is updated to
# match so sudo and local lookups stay consistent.
#
# LEAVE BLANK (the default) to keep the machine's current hostname. Renaming a
# host is not something an installer should do because an example file said
# so, and this is unrelated to the home.arpa service names — those come from
# LOCAL_DOMAIN below and work regardless of what this machine calls itself.
SERVER_HOSTNAME=

# LAN interface and address that other devices reach this server on.
# Leave BOTH blank to auto-detect from the default route. Auto-detection is
# fine for a single-NIC box; set them explicitly on multi-homed hosts.
# The address must be static (DHCP reservation or static config) — every
# *.home.arpa name resolves here, so it must not change.
LAN_INTERFACE=
LAN_IP=

# Set true if LAN_IP is DHCP-assigned but RESERVED for this host on your router.
#
# Preflight can see that an address came from DHCP, but not that the router has
# reserved it — a reservation is server-side state the client never learns
# about. So a correctly-reserved address still trips the warning. This setting
# is you telling the installer "I have handled it".
#
# Leave false if the address is genuinely static, or if you have not reserved
# it yet. To make it static on this host instead:  sudo ./tools/set-static-ip.sh
LAN_IP_IS_RESERVED=false

# --- Local domain ----------------------------------------------------------

# Private DNS namespace. RFC 8375 reserves home.arpa for exactly this.
# Do NOT use .local (that is mDNS/Bonjour and will conflict).
LOCAL_DOMAIN=home.arpa

# Service hostnames. Each must be a single label under LOCAL_DOMAIN
# (Runtipi validates the label against /^[a-zA-Z0-9-]{1,63}$/).
#
# NOTE: there is no setting for the Runtipi dashboard's hostname. Runtipi
# binds it to the bare LOCAL_DOMAIN itself, so with the value above the
# dashboard is at http://home.arpa. See docs/runtipi.md#the-dashboard-hostname.
DNS_DOMAIN=dns.home.arpa

# --- Version policy --------------------------------------------------------

# Either "stable" (resolve the newest non-prerelease upstream release at
# install time) or an exact immutable tag, e.g. v4.10.1.
#
# "stable" is resolved ONCE per installation run and then recorded in
# /var/lib/u-server/installed-manifest.json. A later rerun of install.sh
# reuses the recorded version and will NOT silently upgrade a running node —
# upgrades are always explicit via ./update.sh. See docs/architecture.md.
RUNTIPI_VERSION=stable

# --- Components ------------------------------------------------------------

# AdGuard Home provides LAN DNS and the *.home.arpa wildcard.
INSTALL_ADGUARD=true

# --- DNS behaviour ---------------------------------------------------------

# Upstream resolvers AdGuard forwards to when WAN connectivity exists.
# When the WAN is down these simply fail; *.home.arpa keeps resolving because
# it is answered locally by a DNS rewrite, never forwarded.
ADGUARD_UPSTREAM_DNS="https://dns.quad9.net/dns-query 9.9.9.9 149.112.112.112"

# systemd-resolved binds 127.0.0.53:53 by default, which collides with
# AdGuard. When true the installer disables only the stub listener and
# repoints /etc/resolv.conf, keeping the host able to resolve throughout.
# Setting this false means you must free port 53 yourself.
DISABLE_RESOLVED_STUB=true

# --- HTTPS -----------------------------------------------------------------

# READ THIS EVEN IF YOU LEAVE IT FALSE.
#
# HTTPS is not optional here and this setting does not switch it on. Runtipi
# gives every locally-exposed app a TLS router AND redirects the plain-HTTP
# one to it, so http://home.arpa already becomes https://home.arpa on a stock
# install. What you get by default is Runtipi's own self-signed certificate:
# genuinely encrypted, signed by nobody, so every browser warns.
#
# Setting this true replaces that certificate with one issued by a local
# certificate authority this installer creates and keeps at /etc/u-server/ca.
# Install that CA on your phones and laptops once and the warnings stop for
# every service, present and future — the certificate covers *.home.arpa.
# A daily systemd timer reissues it before it expires.
#
# It is opt-in because creating a CA puts a private key on this machine that
# can vouch for any name to any device that trusts it. That is a deliberate
# decision, not a default.
#
# Let's Encrypt is NOT an option for home.arpa, and no setting changes that.
# ACME requires a publicly-delegable name: HTTP-01 needs Let's Encrypt to reach
# this host from the Internet, DNS-01 needs a TXT record in a public zone.
# RFC 8375 reserves home.arpa specifically so it is neither. Real public
# certificates require giving up home.arpa for a domain you own — docs/https.md
# describes that trade in full.
ENABLE_LOCAL_HTTPS=false

# --- Firewall --------------------------------------------------------------

# Off by default: this installer will not silently reconfigure a firewall and
# risk locking you out over SSH. When true, ufw is configured to allow
# SSH, 53/tcp, 53/udp, 80/tcp and 443/tcp only. Review docs/troubleshooting.md
# before enabling on a remote machine.
MANAGE_FIREWALL=false

# --- Runtipi placement -----------------------------------------------------

# Where the Runtipi CLI and its runtime state live on the host.
RUNTIPI_ROOT=/opt/runtipi
